# ============================================================
# TrainTrack Environment Variables - Example
# ============================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ============================================================

# โดเมนหลักของแอปสำหรับสร้างลิงก์ (เช่น ลิงก์รีเซ็ตรหัสผ่านในอีเมล)
# ในโหมด Production ให้เปลี่ยนเป็นโดเมนจริง เช่น https://traintrack.vercel.app
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email API (https://resend.com) - optional fallback
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=TrainTrack <onboarding@resend.dev>

# Gmail SMTP (แนะนำ: ไม่ต้องซื้อโดเมน ใช้ App Password)
# วิธีตั้งค่า: เปิด 2-Step Verification → https://myaccount.google.com/apppasswords
# ระบบจะใช้ Gmail ก่อน ถ้าไม่ตั้งค่า GMAIL_USER จะ fallback ไป Resend
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Supabase (optional - ใช้เมื่อต้องการเชื่อมต่อฐานข้อมูลจริง)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx
# หรือใช้ชื่อใหม่ของ Supabase:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_xxxxxxxxxxxxxxxxxxxx

